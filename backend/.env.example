# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/findmydoctor
DB_HOST=localhost
DB_PORT=5432
DB_NAME=findmydoctor
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Application Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1
TIMEZONE=Asia/Manila

# AI Configuration
AI_API_KEY=your_ai_provider_api_key
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-3.5-turbo
AI_DAILY_LIMIT=20
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=10
AI_MAX_MESSAGE_LENGTH=2000
AI_MAX_TOKENS=500
AI_CONTEXT_WINDOW_MESSAGES=5

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=4194304
ALLOWED_FILE_TYPES=image/png

# Rate Limiting
# General API budget: sized for normal dashboard navigation with burst headroom.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
# Strict budget for login, OTP, registration, and password-change routes.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=30
# Short-lived server-side availability cache (cleared on every scheduling write).
AVAILABILITY_CACHE_TTL_MS=20000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8080

# Supabase Configuration (for OTP email verification, Edge Functions, and Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
FUNCTION_SECRET=your_supabase_edge_function_secret
SUPABASE_STORAGE_BUCKET=doctor-photos
SUPABASE_GCASH_BUCKET=gcash-qr-codes
SUPABASE_RECEIPT_BUCKET=payment-receipts

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3001